# Copy to .env for local development. Never commit .env (INV-18).
#
# Every variable here is documented in docs/13-reference/environment-variables.md.
# A variable that exists in code but not in this file is a bug: the next
# developer cannot know it exists.

# ---- Process role (ADR-001) -------------------------------------------------
# api | ingest | relay | consumer | projector | worker:<queues> | scheduler
NEXUS_ROLE=api

# ---- Database (ADR-002) -----------------------------------------------------
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus_development

# ---- Event backbone (ADR-003) -----------------------------------------------
# postgres = full event path with no broker (default; used by CI)
# kafka     = production transport
NEXUS_EVENT_TRANSPORT=postgres
# KAFKA_BROKERS=localhost:9092

# ---- Redis --------------------------------------------------------------
# Cache, rate limits, locks, live-push fan-out. INV-08: never authoritative.
# The application must run correctly with this unset — try it.
REDIS_URL=redis://localhost:6379/0

# ---- Tenancy (ADR-009, INV-14) ----------------------------------------------
# Isolation layer (c). Setting this to false is ONLY for the isolation test
# suite, which disables each layer in turn to prove the others still deny.
# Never set it to false anywhere a human can reach.
NEXUS_ENFORCE_TENANT_CONTEXT=true

# ---- AI providers (ADR-007) -------------------------------------------------
# Provider credentials. Never logged, never traced, never placed in a prompt.
# ANTHROPIC_API_KEY=

# Default routing tier when an agent does not pin one:
# economy | standard | premium | frontier
NEXUS_DEFAULT_MODEL_TIER=standard

# Default reasoning effort: low | medium | high | xhigh | max
NEXUS_DEFAULT_EFFORT=high

# ---- Observability (INV-23) -------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=aegis-nexus-control-plane

# ---- Secrets ----------------------------------------------------------------
# Envelope-encryption master key reference. In production this is a KMS key ID,
# never key material. See docs/08-security/secrets-management.md.
# NEXUS_KMS_KEY_ID=
